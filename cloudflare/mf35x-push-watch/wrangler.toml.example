name = "mf35x-push-watch"
main = "src/index.js"
compatibility_date = "2026-08-27"

[triggers]
crons = ["* * * * *"]

[vars]
FIREBASE_DB_URL = "https://tracker-989a9-default-rtdb.europe-west1.firebasedatabase.app"
FIREBASE_PROJECT_ID = "tracker-989a9"
OFFLINE_AFTER_MS = "45000"
# Optional: Beim Antippen der Pushmeldung diese Seite oeffnen.
# APP_URL = "https://DEINE-GITHUB-PAGES-ADRESSE/"

# Nach dem Erstellen des KV-Namespace die echte ID eintragen.
[[kv_namespaces]]
binding = "STATE"
id = "REPLACE_WITH_CLOUDFLARE_KV_NAMESPACE_ID"

# NIEMALS hier eintragen:
# - GOOGLE_SERVICE_ACCOUNT_JSON
# - FCM_TOKEN
# Diese beiden Werte als Cloudflare Worker Secrets speichern.
